{
  "name": "hub-challenge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "predev:api": "node scripts/setup.mjs",
    "dev:api": "cd api && func start",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:api\"",
    "dev:local": "npm run db:up && npm run dev:all",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "dotnet run --project tools/Seed",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
